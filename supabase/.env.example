# Copy to supabase/.env. Read by the Supabase CLI for env(...) values in config.toml.

# Google OAuth for LOCAL development. https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
