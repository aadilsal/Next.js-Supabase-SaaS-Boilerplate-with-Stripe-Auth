# =============================================================================
# VersaLaunch environment variables
#
#   cp .env.example .env.local      # then fill in the values below
#
# Every variable is validated in src/env.ts: a missing REQUIRED value fails with
# a clear error message. OPTIONAL features stay switched off until configured.
# Never commit .env.local. In production, set these in your host (e.g. Vercel →
# Project → Settings → Environment Variables).
# =============================================================================

# ── App (required) ───────────────────────────────────────────────────────────
# Public URL of the app, no trailing slash. Used for redirects and email links.
# Local: http://localhost:3000 · Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required) ──────────────────────────────────────────────────────
# LOCAL:      run `pnpm db:start` and copy the values it prints:
#               API URL                          → NEXT_PUBLIC_SUPABASE_URL
#               anon key (or Publishable key)    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#               service_role key (or Secret key) → SUPABASE_SERVICE_ROLE_KEY
# PRODUCTION: Supabase Dashboard → your project → Project Settings → API Keys
#             (Project URL is under Project Settings → Data API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SERVER-ONLY. Bypasses Row Level Security. Never expose it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (optional until you turn on billing) ──────────────────────────────
# Stripe Dashboard → Developers → API keys → "Secret key".
# Use TEST keys (sk_test_...) locally and LIVE keys (sk_live_...) in production.
STRIPE_SECRET_KEY=
# LOCAL:      printed by `pnpm stripe:listen` (starts with whsec_...).
# PRODUCTION: Stripe Dashboard → Developers → Webhooks → your endpoint → "Signing secret".
STRIPE_WEBHOOK_SECRET=
# Price IDs (price_...): Stripe Dashboard → Product catalog → open a product →
# Pricing → click the price → copy its ID. Used in src/config/billing.ts.
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=

# ── Email via Resend (optional) ──────────────────────────────────────────────
# resend.com → API Keys → Create API key. Without it, app emails (welcome,
# invitations) are printed to the server console instead of being sent.
RESEND_API_KEY=
# Sender. onboarding@resend.dev works for testing; for real users, verify your
# domain in Resend → Domains and use an address on it.
EMAIL_FROM="VersaLaunch <onboarding@resend.dev>"

# ── Error tracking via Sentry (optional) ─────────────────────────────────────
# sentry.io → create a Next.js project → Settings → Client Keys (DSN).
# Empty = Sentry off. Errors are still logged to the console and app_logs table.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, to upload source maps for readable stack traces:
# sentry.io → Settings → Auth Tokens (org/project slugs are in your Sentry URL).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google sign-in is configured in Supabase, not here:
#   local → supabase/.env (see supabase/.env.example)
#   production → Supabase Dashboard → Authentication → Sign In / Providers → Google
